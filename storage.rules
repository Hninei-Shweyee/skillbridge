rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Any signed-in user can read all files (thumbnails, PDFs, resources)
    // Any signed-in user can upload (admin check is enforced by the app)
    match /{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
                   && request.resource.size < 52428800; // 50MB max
    }
  }
}
