# SkillBridge — Firebase Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
# 1. Copy this file and rename it to .env  (cp .env.example .env)
# 2. Go to Firebase Console → Project Settings → Your apps → Web app → Config
# 3. Paste the values from Firebase into the fields below
# 4. NEVER commit the .env file to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
